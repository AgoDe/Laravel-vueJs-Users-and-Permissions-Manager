								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{Path}}/api/users?status=active",
							"host": [
								"{{Path}}"
							],
							"path": [
								"api",
								"users"
							],
							"query": [
								{
									"key": "page",
									"value": "2",
									"disabled": true
								},
								{
									"key": "search",
									"value": "test@example.com",
									"disabled": true
								},
								{
									"key": "role",
									"value": "admin",
									"disabled": true
								},
								{
									"key": "status",
									"value": "active"
								}
							]
						}
					},
					"response": []
				},
				{
